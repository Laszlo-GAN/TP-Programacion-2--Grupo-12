@startuml Fogon Del Barrio

skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

title Fogon Del Barrio

' ========== PEDIDOS ==========

abstract class Pedido {
  - codigo: string
  - fechaHora: Date
  - estado: EstadoPedido
  - items: ItemPedido[]
  - historial: Acciones[]
  
  + {abstract} datosDelPedido(): string
  + getEstado(): EstadoPedido
  + agregarItem(item: ItemPedido): void
  + quitarItem(item: ItemPedido): void
  + deshacerUltimaModificacion(): void
  + confirmar(cocina: Cocina): void
  + puedeFacturarse(): boolean
  + finalizar(): void
  + calcularTotalProductos(): number
  - verificarEnConstruccion(): void
}

abstract class EstadoPedido {
  # pedido: Pedido
  # confirmarFacturacion: boolean
  # confirmarModificacion: boolean

  + setPedido(pedido: Pedido)
  + confirmarFacturacion(): void
  + confirmarModificacion(): void
  + abstract finalizarPedido(): void
  + abstract confirmarPedido(): void
}

class PedidoEnConstruccion {

}

class PedidoConfirmado {

}

class PedidoFinalizado {

}

class Mesa {
  - numero: number

  + getNumero(): number
}

class PedidoSalon{
  - mesa: Mesa
  - lugares: number
  - mozo: string

  + datosDelPedido(): string
}

class PedidoRetirar {
  - horarioRetiro: Date

  + datosDelPedido(): string
}

class PedidoEnvio{
  - direccion: string
  - costoEnvio: number

  + datosDelPedido(): string
}

Pedido <|-- PedidoSalon
Pedido <|-- PedidoRetirar
Pedido <|-- PedidoEnvio
EstadoPedido <|-- PedidoConfirmado
EstadoPedido <|-- PedidoEnConstruccion
EstadoPedido <|-- PedidoFinalizado
PedidoSalon --> Mesa

' ============== PRODUCTO ===========

abstract class Producto{
  - nombre: string
  - categoria: string
  
  + {abstract} calcularPrecio(): number
  + {abstract} productosDeCocina(): ProductoUnico[]
}

class ProductoUnico{
  - precioBase: number
  - tipoEstacion: TipoEstacion

  + calcularPrecio(): number
  + estacionDeCocina(): TipoEstacion
  + productosDeCocina(): ProductoUnico[]
}

class PrecioFijo {
  - precio: number

  + calcularPrecio(): number
}

interface Acciones {
  + aplicar(): void
  + deshacer(): void
}

class AgregarItem {
  - items: ItemPedido[]
  - item: ItemPedido

  + aplicar(): void
  + deshacer(): void
}

class QuitarItem {
  - items: ItemPedido[]
  - item: ItemPedido
  - seQuito: boolean
  - posicion: number

  + aplicar(): void
  + deshacer(): void
}

enum TipoEstacion {
  PARRILLA
  COCINA_FRIA
  BARRA
  COCINA_DULCE
}
Acciones <|.. AgregarItem
Acciones <|.. QuitarItem
Pedido o-- Acciones 
Pedido  *--  ItemPedido
Pedido *--> EstadoPedido
Pedido ..> Cocina 
Producto <|-- ProductoUnico
Producto <|-- Combo

' ================= Cocina y Estaciones ===============

class Cocina {
  - estaciones: Estacion[]

  + aQueEstacionVa(producto: ProductoUnico): Estacion
  + enviarItem(item: ItemPedido): void
}

abstract class Estacion {
  # nombre: string
  # tipo: TipoEstacion
  # colaItems: ItemPedido[]
  # itemActual: ItemPedido | undefined
  # estado: EstadoEstacion

  + cambiarEstado(estado: EstadoEstacion): void
  + getTipo(): TipoEstacion
  + procesarItemActual(): void
  + recibirItems(item: ItemPedido): void
  + procesarSiguiente(): void
  + terminarItemActual(): void
}

class Parrilla {}

class CocinaFria {}

class Barra {}

class CocinaDulce {}

abstract class EstadoEstacion {
  # estacion: Estacion

  + setEstacion(estacion: Estacion)
  + abstract ocuparse(): void
  + abstract liberarse(): void
  + abstract procesarSiguiente(): void
}

class EstacionLibre {

}

class EstacionOcupada {

}

ProductoUnico .u.> TipoEstacion
Estacion *--> EstadoEstacion
EstadoEstacion <|-- EstacionLibre
EstadoEstacion <|-- EstacionOcupada
Estacion ..> TipoEstacion
Cocina o--  Estacion
Cocina ..> ProductoUnico 
Cocina ..> ItemPedido 
Estacion <|-- Parrilla
Estacion <|-- CocinaFria
Estacion <|-- Barra
Estacion <|-- CocinaDulce
Estacion o--  ItemPedido 

' ============= Items ===========

class ItemPedido {
  - codigo: string
  - producto: Producto
  - cantidad: number
  - estado: EstadoItem
  - padre!: ItemPedido
  - partes: ItemPedido[]

  + cambiarEstado(estado: EstadoItem)
  + setPadre(padre: ItemPedido): void
  + asignarPartes(partes: ItemPedido[]): void
  + actualizarEstadoSegunPartes(): void
  + enPreparacion(): void
  + listo(): void
  + puedeModificarse(): boolean
}

abstract class EstadoItem {
  # itemPedido: ItemPedido
  # puedeModificarse: boolean
  # estaListo: boolean
  # estaEnPreparacion: boolean
  # estaPendiente: boolean

  + setItemPedido(itemPedido: ItemPedido): void
  + confirmarModificacion(): boolean
  + abstract listo(): void
  + abstract enPreparacion(): void
}

class ItemPendiente {

}

class ItemEnPreparacion {

}

class ItemListo

ItemPedido *--> EstadoItem
ItemPedido --> Producto
EstadoItem <|-- ItemEnPreparacion
EstadoItem <|-- ItemListo
EstadoItem <|-- ItemPendiente

' ========= beneficios ===========

abstract class AplicaBeneficio{
  - beneficiosDisponibles: Beneficio[]

  + aplicarMayorBeneficio(): Beneficio
}
interface Beneficio{
  + tieneBeneficio(): boolean
  + calcularPrecio(): number
  + beneficio(): number
}

class Combo{
  - productos: Producto[]
  - beneficio: BeneficioCombo

  + calcularPrecio(): number
  + productosDeCocina(): ProductoUnico[]
}

interface BeneficioCombo {
  + calcularPrecio(sumaProductos: number): number
}

class DescuentoPorcentual {
  - porcentaje: number

  + calcularPrecio(sumaProductos: number): number
}

Beneficio <|.. BeneficioPorDia
Beneficio <|.. BeneficioEfectivo
AplicaBeneficio o-- Beneficio
Combo --> BeneficioCombo
Combo o--  Producto
BeneficioCombo <|.. DescuentoPorcentual
BeneficioCombo <|.. PrecioFijo

'========== factura =======

class Factura{
  - medioDePago: MedioDePago
  - fecha: Date
  - totalApagar: number
  - tieneBeneficio: boolean
  - pedido: Pedido
}

enum MedioDePago {
  EFECTIVO
  DEBITO
  CREDITO
  BILLETERA_VIRTUAL
}

Factura --> Pedido
Factura --> MedioDePago
Factura --> Beneficio
Factura --> AplicaBeneficio

@enduml

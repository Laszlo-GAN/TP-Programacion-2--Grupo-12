@startuml name

skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

title Fogon Del Barrio

abstract class Pedidos{
  - nombre: string
  - tipoDePedido: string
  - colaDePedidos: items<list>
  - fechaHora: date

  + abstract datosDelPedido()
  + agregarPedido(): void
  + quitarPedido(): void
  + deshacerUltimaModificacion(): void
  + puedeFacturarse(): boolean
  + calcularTotalProductos(): number

}

class ItemPedido{
  - nombre: string
  - producto: producto
  - cantidad: number
  - estado: estadoDelPedido

  + enProduccion(): void
  + enListo(): void
  + puedeModificarse(): boolean
}
enum EstadoDelPedido{
  ESPERA
  PRODUCCION
  LISTO
}

class PedidoSalon{
  - mesa: mesa
  - lugares: number
  - mozo: number
}

class Mesa{
  -numero: number
}

class PedidoRetirar{
  - telefono: number
  - horarioRetiro: date

  + datosDelPedido(): string
}

class PedidoEnvio{
  - direccion: string
  - costoEnvio: number
}

abstract class Producto{
  - nombre: string
  - categoria: string
  - abstract precioBase: number

  + abstract precioConBeneficio(): number
  + abstract estacionDeCocina(): string
  + abstract benecifio(): number
}

enum Categoria{
  ENTRADA
  PLATOS_PRINCIPALES
  BEBIDAS
  POSTRES
}

class ProductoUnico{
  
}

class Combo{
  - productoIncluido: string
}

abstract class Estacion {
  - nombre: string
  - colaItems: list<colaDePedidos>

  + abstract recibirItems(): void
  + abstract procesarSiguiente(): void
}

class Parrilla {}

class CocinaFria {}

class Barra {}

class CocinaDulce {}

class ItemPedido {
- nombre: string
- producto: Producto
- cantidad: number
- estado: EstadoItem

+ marcarEnPreparacion(): void
+ marcarListo(): void
+ puedeModificarse(): boolean
}

enum EstadoItem {
  PENDIENTE
  EN_PREPARACION
  LISTO
}

abstract class AplicaBeneficio{
  - benecidioDisponible: list<beneficios>

  + aplicarMayorBeneficio(): beneficio
}
interface Beneficio{
  + tieneBenecifio(): boolean
  + calcularPrecio(): number
  + benecifio(): number
}

class BenecifioEfectivo{}

class BeneficioCombo{}

class BeneficioPorDia{
  - diaSemana: date
}

interface Acciones{
  + aplicar(): void
  + deshacer(): void
}

class AgregarItem{
  - item: ItemPedido
}

class QuitarItem{
  - item: ItemPedido
}

class Factura{
  - medioDePago: string
  - fecha: date
  - totalApagar: number
  - tieneBenecifio: boolean
  - pedido: Pedido

}

ItemPedido -- EstadoDelPedido
ItemPedido --> Producto
Pedidos -- ItemPedido
Pedidos <|-u- PedidoSalon
Pedidos <|-l- PedidoRetirar
Pedidos <|-l- PedidoEnvio
PedidoSalon -l-> Mesa

Producto -- Categoria
Producto <|-- ProductoUnico
Producto <|-- Combo
'Combo <-- BeneficioPorDia
ProductoUnico <-l- Estacion

Estacion <|-- Parrilla
Estacion <|-l- CocinaFria
Estacion <|-- Barra
Estacion <|-- CocinaDulce
Estacion o-r- ItemPedido 


ItemPedido -- EstadoItem
ItemPedido -->Producto


Beneficio <|.. BeneficioCombo
Beneficio <|.. BeneficioPorDia
Beneficio <|.. BenecifioEfectivo
AplicaBeneficio o-- Beneficio

Acciones <|.l. AgregarItem
Acciones <|.. QuitarItem
Pedidos o-- Acciones

Factura --> Pedidos
Factura --> medioDePago
Factura --> Beneficio
Factura --> AplicaBeneficio


@enduml
